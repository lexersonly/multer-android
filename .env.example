# Nada aqui é obrigatório: o app busca o pool gratuito no site do Multer sozinho.
# Endereço de onde o pool de chaves gratuitas é lido.
MULTER_FREE_URL=https://multer-builderai.vercel.app
# Token só de leitura do pool, se o embutido for trocado no servidor.
# MULTER_FREE_TOKEN=
# Chaves próprias, separadas por vírgula, para não usar o pool do site.
# MULTER_FREE_KEYS=sk-aaa,sk-bbb
# API do provedor (só muda se apontar para outro servidor).
# MULTER_FREE_API_URL=https://api.nightrouter.ai/v1
