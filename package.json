  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ink": "8.0.0",
    "rea-agents": "6.8.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
