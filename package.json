{
  "name": "multer-android",
  "version": "0.3.0",
  "description": "Multer no terminal, para rodar dentro do Termux",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "multer": "bin/multer.js"
  },
  "scripts": {
    "start": "node bin/multer.js",
    "typecheck": "tsc",
